# токен от @BotFather
BOT_TOKEN=123456789:AA...ваш_токен...

# путь к файлу с данными (по желанию)
# DATA_FILE=call_bot_data.json

# сайт школы (главная или сразу страница «Расписание»)
# SCHOOL_URL=https://example-school.ru/raspisanie
# SCHOOL_CLASS=8А
# как часто проверять сайт, секунды (минимум 60, по умолчанию 900 = 15 минут)
# SCHEDULE_POLL_SECONDS=900
# если у сайта школы старый сертификат:
# SCHOOL_INSECURE_SSL=1
