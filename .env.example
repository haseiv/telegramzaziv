# токен от @BotFather
BOT_TOKEN=123456789:AA...ваш_токен...

# путь к файлу с данными (по желанию)
# DATA_FILE=call_bot_data.json

# сайт школы (по умолчанию уже СОШ №46: https://sosh46.ru/raspisanie/)
# SCHOOL_URL=https://sosh46.ru/raspisanie/
# SCHOOL_CLASS=8А
# как часто проверять сайт, секунды (минимум 60, по умолчанию 600 = 10 минут)
# SCHEDULE_POLL_SECONDS=600
# час UTC+4, когда слать вечернее расписание на завтра (по умолчанию 18)
# SCHEDULE_DAILY_HOUR=18
# если у сайта школы старый сертификат:
# SCHOOL_INSECURE_SSL=1
